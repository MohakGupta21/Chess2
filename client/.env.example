# Copy to client/.env and adjust. Both values are optional.

# --- Local dev only (`npm run dev`) ---------------------------------------
# Backend the Vite dev server proxies /api to. Defaults to http://localhost:4000.
# This is NOT bundled into the app — it only configures the dev proxy.
API_TARGET="http://localhost:4000"

# --- Deployed builds only (`npm run build`) -----------------------------
# Absolute base URL of the API server, baked into the bundle at build time.
# Set this ONLY for a split deploy where the client is served from a different
# origin than the server, e.g.
#   VITE_API_BASE_URL="https://chess2-ntxt.onrender.com"
# Leave it UNSET (or empty) for local dev and for the single-origin deploy
# (where the server serves client/dist) — the app then calls /api on its own
# origin.
#
# A split deploy also needs, on the server:
#   CLIENT_ORIGIN   = this client's exact origin (scheme + host [+ port]) for CORS
#   COOKIE_SAMESITE = none   (so the browser keeps/sends the auth cookie)
# and both origins must be HTTPS.
# VITE_API_BASE_URL=""
