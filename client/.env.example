# Copy to client/.env and adjust. All values here are optional.

# --- Local dev only (`npm run dev`) -----------------------------------------
# Where the Vite dev server proxies /api. Defaults to http://localhost:4000.
VITE_API_BASE_URL="http://localhost:4000"

# --- Deployed builds only (`npm run build`) --------------------------------
# Absolute base URL of the API server. Set this ONLY when the client is hosted
# on a different origin than the server, e.g.
#   VITE_API_BASE_URL="https://chess-api.onrender.com"
# Leave it unset for the single-origin deploy (the server serves client/dist)
# and for local dev (the proxy above handles it).
#
# NOTE: cross-origin also requires, on the server:
#   CLIENT_ORIGIN = the client's origin (for CORS)
#   the auth cookie issued as `SameSite=None; Secure` (see server config)
# VITE_API_BASE_URL=""
