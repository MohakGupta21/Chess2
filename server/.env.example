# Copy to server/.env for local runs (loaded by your shell / process manager;
# the app itself just reads process.env). All optional in dev.

# Postgres connection string. Dev defaults to the docker-compose database:
#   postgres://chess:chess@localhost:5433/chess
# Required in production (the server throws on startup without it).
DATABASE_URL="postgres://chess:chess@localhost:5433/chess"

# TLS for the DB connection: "require" | "disable". Auto-detected off for
# localhost, on for everything else (managed providers need it).
# DATABASE_SSL=require

# JWT signing secret. Random ephemeral value in dev; REQUIRED in production.
# JWT_SECRET="$(openssl rand -hex 32)"

# Port to listen on (default 4000).
# PORT=4000

# Split (cross-origin) deploy only:
# CLIENT_ORIGIN="https://your-client.example.com"
# COOKIE_SAMESITE=none

# Behind a proxy / load balancer (Render, nginx, …):
# TRUST_PROXY=1

# Serve the built client from this server (single-origin deploy):
# CLIENT_DIST=/abs/path/to/client/dist
